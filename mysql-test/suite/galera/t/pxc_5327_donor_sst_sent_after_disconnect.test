#
# PXC-5327: Donor's detached SST thread calls sst_sent() after provider close.
#
# The SST donor thread reports the end of the donation through sst_sent().
# If replication was stopped in the meantime, the report reached a closed
# provider and Galera logged
#   [ERROR] ... sst sent called when not SST donor, state CLOSED
#
# The donor thread is held just before sst_sent(), replication is stopped on
# the donor, and then the donor thread continues. The end of the SST must not
# be passed to the closed provider.
#

--source include/big_test.inc
--source include/have_debug_sync.inc
--source include/galera_cluster.inc

--connection node_2
--let $node_2_cluster_address = `SELECT @@global.wsrep_cluster_address`

# The error log is checked through performance_schema.error_log, which also
# holds the entries of the tests run before this one on this server
--let $sst_errors_before = `SELECT COUNT(*) FROM performance_schema.error_log WHERE DATA LIKE "%sst sent called when not SST donor%" OR DATA LIKE "%wsrep::sst_sent() returned an error%"`
--let $skipped_before = `SELECT COUNT(*) FROM performance_schema.error_log WHERE DATA LIKE "%not reporting the end of the SST to the provider%"`

--echo # Hold node_2 donor thread before it reports the end of the SST
SET GLOBAL debug = '+d,syncpoint_wsrep_donor_before_sst_sent';

--echo # Restart node_1, it rejoins with IST from node_2
--connection node_1
--let $do_not_echo_parameters = 1
--let $restart_parameters = "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_2"
--source include/restart_mysqld.inc
--source include/galera_wait_ready.inc

--connection node_2
SET DEBUG_SYNC = 'now WAIT_FOR reached_wsrep_donor_before_sst_sent';
SET GLOBAL debug = '-d,syncpoint_wsrep_donor_before_sst_sent';

--echo # Stop replication on node_2 while the donor thread is held
# Other client connections on node_2 are closed by this
SET GLOBAL wsrep_cluster_address = '';

--echo # Let the donor thread report the end of the SST
SET DEBUG_SYNC = 'now SIGNAL continue_wsrep_donor_before_sst_sent';

--echo # The end of the SST is not passed to the closed provider
# The node is disconnected: no sync wait
SET SESSION wsrep_sync_wait = 0;
--let $wait_condition = SELECT COUNT(*) > $skipped_before FROM performance_schema.error_log WHERE DATA LIKE "%not reporting the end of the SST to the provider%"
--source include/wait_condition.inc

# The donor thread drops the SST user after sst_sent(). Let it finish before
# reconnecting: restarting replication closes the local sessions, including
# the one dropping the user.
--echo # Wait for the donor thread to drop the SST user
SET SESSION wsrep_on = OFF;
--let $wait_condition = SELECT COUNT(*) = 0 FROM mysql.user WHERE user = 'mysql.pxc.sst.user'
--source include/wait_condition.inc
SET SESSION wsrep_on = ON;

--echo # Reconnect node_2 to the cluster
--disable_query_log
--eval SET GLOBAL wsrep_cluster_address = '$node_2_cluster_address'
--enable_query_log
--source include/galera_wait_ready.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc

--let $assert_text = node_2 must not report sst_sent() to a closed provider
--let $assert_cond = [SELECT COUNT(*) FROM performance_schema.error_log WHERE DATA LIKE "%sst sent called when not SST donor%" OR DATA LIKE "%wsrep::sst_sent() returned an error%"] = $sst_errors_before
--source include/assert.inc

SET DEBUG_SYNC = 'RESET';

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc
