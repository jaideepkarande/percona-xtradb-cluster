# ==== Purpose ====
# PXC-5201: split-brain protection via super_read_only on the DR cluster.
#
#   * FR-S1: while enabled in RECEIVER mode with read_only management ON, the
#            node is placed in super_read_only and normal writes are refused.
#   * FR-S3: turning wsrep_async_failover_read_only OFF releases ONLY the bit the
#            coordinator itself set; a DBA-set super_read_only is left untouched.
# ==================
--source include/have_wsrep_provider.inc

SET SESSION sql_log_bin = 0;
CALL mtr.add_suppression("\\[wsrep-acf\\]");
SET SESSION sql_log_bin = 1;

--echo #
--echo # Setup: fast interval, RECEIVER mode, read_only management ON.
--echo #
SET GLOBAL wsrep_async_failover_check_interval = 1;
SET GLOBAL wsrep_async_failover_channel = '';
SET GLOBAL wsrep_async_failover_mode = 'RECEIVER';
SET GLOBAL wsrep_async_failover_read_only = ON;
SET GLOBAL wsrep_async_failover = ON;

--echo #
--echo # 1. The coordinator enables super_read_only on the DR node (FR-S1).
--echo #
--let $wait_condition= SELECT @@GLOBAL.super_read_only = 1
--source include/wait_condition.inc
SELECT @@GLOBAL.super_read_only;
SELECT SUPER_READ_ONLY_MANAGED FROM performance_schema.wsrep_async_failover_status;

--echo #
--echo # 2. A normal client write is refused while super_read_only holds (FR-S1).
--echo #
--error ER_OPTION_PREVENTS_STATEMENT
CREATE TABLE t1 (a INT);

--echo #
--echo # 3. Turning the knob OFF releases the coordinator-set bit (FR-S3).
--echo #
SET GLOBAL wsrep_async_failover_read_only = OFF;
--let $wait_condition= SELECT @@GLOBAL.super_read_only = 0
--source include/wait_condition.inc
SELECT @@GLOBAL.super_read_only;
SELECT SUPER_READ_ONLY_MANAGED FROM performance_schema.wsrep_async_failover_status;

--echo #
--echo # 4. A DBA-set super_read_only is left untouched by the coordinator: with
--echo #    the knob OFF the coordinator manages nothing, so the bit persists.
--echo #
SET GLOBAL super_read_only = ON;
SELECT @@GLOBAL.super_read_only;
SELECT SUPER_READ_ONLY_MANAGED FROM performance_schema.wsrep_async_failover_status;

--echo #
--echo # 5. Clean up.
--echo #
SET GLOBAL super_read_only = OFF;
SET GLOBAL read_only = OFF;
SET GLOBAL wsrep_async_failover = OFF;
SET GLOBAL wsrep_async_failover_mode = 'OFF';
SET GLOBAL wsrep_async_failover_read_only = ON;
SET GLOBAL wsrep_async_failover_check_interval = 5;
