--source include/galera_cluster.inc

# Set sql_generate_invisible_primary_key to OFF
--connection node_1
SET GLOBAL sql_generate_invisible_primary_key = OFF;
SELECT @@global.sql_generate_invisible_primary_key = 0;

--connection node_2
SET GLOBAL sql_generate_invisible_primary_key = OFF;
SELECT @@global.sql_generate_invisible_primary_key = 0;

# Set session sql_generate_invisible_primary_key to OFF
# So that session value is not picked.
--connection node_1
# session node_1 has session-level GIPK enabled (inherited at startup)
# We can set session level
SET SESSION sql_generate_invisible_primary_key = OFF;
CREATE DATABASE gipk_test;
CREATE TABLE gipk_test.t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;

# Assert Generated Invisible Primary Keys(GIPK) is not generated on any node

--connection node_1
--let $assert_text = node_1 should not have generated my_row_id
--let $assert_cond= "[SELECT COUNT(*) COUNT FROM INFORMATION_SCHEMA.COLUMNS WHERE table_schema = \'gipk_test\' AND table_name = \'t1\' AND column_name = \'my_row_id\', COUNT, 1]" = "0"
--source include/assert.inc

--connection node_2
--let $pk_count = `SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = 'gipk_test' AND table_name = 't1' AND column_name = 'my_row_id'`
--let $assert_text = node_2 should not have generated my_row_id
--let $assert_cond = $pk_count = 0
--source include/assert.inc

# Cleanup
--connection node_1
DROP DATABASE gipk_test;
SET GLOBAL sql_generate_invisible_primary_key = ON;

--connection node_2
SET GLOBAL sql_generate_invisible_primary_key = ON;
