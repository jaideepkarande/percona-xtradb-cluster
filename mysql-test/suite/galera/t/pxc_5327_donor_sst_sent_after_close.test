#
# PXC-5327: Donor's detached SST thread calls sst_sent() after provider close.
#
# The SST donor thread reports the end of the donation through sst_sent().
# If replication was stopped while that call was inside the provider, the
# provider was closed under it and Galera logged
#   [ERROR] ... sst sent called when not SST donor, state CLOSED
#
# The test parks node_2's donor thread inside Galera's sst_sent() (the
# "sst_sent" sync point) and stops replication on node_2. The stop must wait
# for the call to return before it closes the provider.
#

--source include/big_test.inc
--source include/have_debug_sync.inc
--source suite/galera/include/galera_have_debug_sync.inc
--source include/galera_cluster.inc

--connection node_2
--let $node_2_cluster_address = `SELECT @@global.wsrep_cluster_address`

--echo # Park node_2 donor thread inside Galera sst_sent()
--let $galera_sync_point = sst_sent
--source include/galera_set_sync_point.inc

--echo # Restart node_1, it rejoins with IST from node_2
--connection node_1
--let $do_not_echo_parameters = 1
--let $restart_parameters = "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_2"
--source include/restart_mysqld.inc
--source include/galera_wait_ready.inc

--connection node_2
--source include/galera_wait_sync_point.inc
--source include/galera_clear_sync_point.inc

# Opened before the stop: stopping replication closes the other client
# connections on node_2 once the provider is disconnected, including the
# default node_2 connection, which is not used after this.
--connect node_2b, 127.0.0.1, root, , test, $NODE_MYPORT_2
SET SESSION wsrep_sync_wait = 0;

# Only node_2 error log lines written from now on are checked
--perl
  my $vardir = $ENV{'MYSQLTEST_VARDIR'};
  open(my $fh, '<', "$vardir/log/mysqld.2.err") or die "cannot open: $!";
  my $lines = 0;
  $lines++ while <$fh>;
  close $fh;
  open(my $out, '>', "$vardir/tmp/pxc_5327_offset") or die "cannot write: $!";
  print $out "$lines\n";
  close $out;
EOF

--echo # Stop replication on node_2 while the donor thread is still in sst_sent()
--connect node_2a, 127.0.0.1, root, , test, $NODE_MYPORT_2
--send SET GLOBAL wsrep_cluster_address = ''

--echo # The stop must wait for sst_sent() before closing the provider
--connection node_2b
--perl
  my $vardir = $ENV{'MYSQLTEST_VARDIR'};
  open(my $in, '<', "$vardir/tmp/pxc_5327_offset") or die "cannot open: $!";
  my $offset = <$in>;
  close $in;
  my $found = 0;
  for (1..60) {
    open(my $fh, '<', "$vardir/log/mysqld.2.err") or die "cannot open: $!";
    my $n = 0;
    while (my $line = <$fh>) {
      next if ++$n <= $offset;
      $found = 1 if $line =~ /Waiting for sst_sent\(\) to complete before disconnecting/;
    }
    close $fh;
    last if $found;
    sleep 1;
  }
  die "the stop did not wait for sst_sent()\n" unless $found;
EOF
--remove_file $MYSQLTEST_VARDIR/tmp/pxc_5327_offset

# The server is disconnecting (wsrep_cluster_status is non-Primary), Galera
# itself is still the donor
--let $local_state = query_get_value(SHOW STATUS LIKE 'wsrep_local_state_comment', Value, 1)
--let $assert_text = Galera on node_2 must still be the donor
--let $assert_cond = "$local_state" = "Donor/Desynced"
--source include/assert.inc

--echo # Let the donor thread continue
# Releasing the donor thread lets the server close this connection, possibly
# before the reply is read
--disable_query_log
--error 0,CR_SERVER_LOST,CR_SERVER_GONE_ERROR
--eval SET GLOBAL wsrep_provider_options = 'signal=$galera_sync_point'
--enable_query_log
--disconnect node_2b

--connection node_2a
--reap
--disconnect node_2a

--echo # Reconnect node_2 to the cluster
--connect node_2c, 127.0.0.1, root, , test, $NODE_MYPORT_2

# The donor thread drops the SST user after sst_sent(). Let it finish before
# reconnecting: restarting replication closes the local sessions, including
# the one dropping the user.
SET SESSION wsrep_on = OFF;
--let $wait_condition = SELECT COUNT(*) = 0 FROM mysql.user WHERE user = 'mysql.pxc.sst.user'
--source include/wait_condition.inc
SET SESSION wsrep_on = ON;

--disable_query_log
--eval SET GLOBAL wsrep_cluster_address = '$node_2_cluster_address'
--enable_query_log
--source include/galera_wait_ready.inc

--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc
--disconnect node_2c

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc

--echo # The donor thread must not have reached a closed provider
--let $assert_text = node_2 must not report sst_sent() on a closed provider
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select = sst sent called when not SST donor
--let $assert_count = 0
--source include/assert_grep.inc

--let $assert_text = node_2 sst_sent() must not fail
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select = wsrep::sst_sent\(\) returned an error
--let $assert_count = 0
--source include/assert_grep.inc
