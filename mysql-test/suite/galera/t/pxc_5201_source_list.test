# ==== Purpose ====
# PXC-5201: the coordinator reconciles the ACF candidate source list for a
# managed 'GaleraCluster' group against the live cluster membership published in
# wsrep_incoming_addresses.
#
#   * FR-B1/FR-B4: the primary cluster is registered as a GaleraCluster group.
#   * FR-B2: a live member is kept as a candidate; a candidate that is no longer
#     a member is pruned.
#
# The reconciliation (add AND prune) runs against locally-observable membership
# in BOTH mode; the cross-datacenter membership pull is the destructive
# two-cluster follow-up (testing_plan.md 2.5, low_level_design.md 8.1).
# ==================
--source include/have_wsrep_provider.inc

SET SESSION sql_log_bin = 0;
CALL mtr.add_suppression("\\[wsrep-acf\\]");
CALL mtr.add_suppression("The group .* for the channel .* has been added");
CALL mtr.add_suppression("The group .* for the channel .* has been removed");
SET SESSION sql_log_bin = 1;

--echo #
--echo # Setup: register this node's cluster as a GaleraCluster managed group on
--echo # channel 'clink', then plant a stale candidate that is not a member.
--echo #
--replace_result $SERVER_MYPORT_1 SERVER_MYPORT_1
--eval SELECT asynchronous_connection_failover_add_managed('clink', 'GaleraCluster', 'd1', '127.0.0.1', $SERVER_MYPORT_1, '', 80, 60)
SELECT asynchronous_connection_failover_add_source('clink', '127.0.0.1', 9999, '', 50);

--echo #
--echo # Before reconciliation both the live seed and the stale 9999 are present.
--echo #
SELECT COUNT(*) AS stale_before
  FROM performance_schema.replication_asynchronous_connection_failover
 WHERE CHANNEL_NAME = 'clink' AND PORT = 9999;

--echo #
--echo # Enable the coordinator in BOTH mode (co-located: membership is locally
--echo # observable), read_only management OFF so the test client can write.
--echo #
SET GLOBAL wsrep_async_failover_check_interval = 1;
SET GLOBAL wsrep_async_failover_channel = 'clink';
SET GLOBAL wsrep_async_failover_read_only = OFF;
SET GLOBAL wsrep_async_failover_mode = 'BOTH';
SET GLOBAL wsrep_async_failover = ON;

--echo #
--echo # The stale 9999 candidate is pruned; the live member survives.
--echo #
--let $wait_condition= SELECT COUNT(*) = 0 FROM performance_schema.replication_asynchronous_connection_failover WHERE CHANNEL_NAME = 'clink' AND PORT = 9999
--source include/wait_condition.inc
SELECT COUNT(*) AS stale_after
  FROM performance_schema.replication_asynchronous_connection_failover
 WHERE CHANNEL_NAME = 'clink' AND PORT = 9999;
--replace_result $SERVER_MYPORT_1 SERVER_MYPORT_1
--eval SELECT COUNT(*) AS live_present FROM performance_schema.replication_asynchronous_connection_failover WHERE CHANNEL_NAME = 'clink' AND HOST = '127.0.0.1' AND PORT = $SERVER_MYPORT_1

--echo #
--echo # Clean up.
--echo #
SET GLOBAL wsrep_async_failover = OFF;
SET GLOBAL wsrep_async_failover_mode = 'OFF';
SET GLOBAL wsrep_async_failover_channel = '';
SET GLOBAL wsrep_async_failover_read_only = ON;
SET GLOBAL wsrep_async_failover_check_interval = 5;
SELECT asynchronous_connection_failover_delete_managed('clink', 'd1');
--disable_result_log
SELECT asynchronous_connection_failover_reset();
--enable_result_log
SELECT COUNT(*)
  FROM performance_schema.replication_asynchronous_connection_failover
 WHERE CHANNEL_NAME = 'clink';
