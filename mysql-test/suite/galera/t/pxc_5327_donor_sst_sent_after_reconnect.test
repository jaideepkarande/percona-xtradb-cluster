#
# PXC-5327: Donor's detached SST thread calls sst_sent() after provider close.
#
# The SST donor thread reports the end of the donation through sst_sent().
# If replication was stopped in the meantime, the report reached a closed
# provider and Galera logged
#   [ERROR] ... sst sent called when not SST donor, state CLOSED
#
# Reconnect variant: the donor thread is held just before sst_sent(),
# replication is stopped on the donor and started again, and then the donor
# thread continues. The end of the SST belongs to the previous connection and
# must not be passed to the new one (Galera would log
# "sst sent called when not SST donor, state SYNCED").
#

--source include/big_test.inc
--source include/have_debug_sync.inc
--source include/galera_cluster.inc

--connection node_2
--let $node_2_cluster_address = `SELECT @@global.wsrep_cluster_address`

--echo # Hold node_2 donor thread before it reports the end of the SST
SET GLOBAL debug = '+d,syncpoint_wsrep_donor_before_sst_sent';

--echo # Restart node_1, it rejoins with IST from node_2
--connection node_1
--let $do_not_echo_parameters = 1
--let $restart_parameters = "restart: --wsrep_cluster_address=gcomm://127.0.0.1:$NODE_GALERAPORT_2"
--source include/restart_mysqld.inc
--source include/galera_wait_ready.inc

--connection node_2
SET DEBUG_SYNC = 'now WAIT_FOR reached_wsrep_donor_before_sst_sent';
SET GLOBAL debug = '-d,syncpoint_wsrep_donor_before_sst_sent';

# Only node_2 error log lines written from now on are checked
--perl
  my $vardir = $ENV{'MYSQLTEST_VARDIR'};
  open(my $fh, '<', "$vardir/log/mysqld.2.err") or die "cannot open: $!";
  my $lines = 0;
  $lines++ while <$fh>;
  close $fh;
  open(my $out, '>', "$vardir/tmp/pxc_5327_offset") or die "cannot write: $!";
  print $out "$lines\n";
  close $out;
EOF

--echo # Stop replication on node_2 while the donor thread is held
# Other client connections on node_2 are closed by this
SET GLOBAL wsrep_cluster_address = '';

--echo # Reconnect node_2 to the cluster while the donor thread is held
--disable_query_log
--eval SET GLOBAL wsrep_cluster_address = '$node_2_cluster_address'
--enable_query_log
--source include/galera_wait_ready.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 2 FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_cluster_size'
--source include/wait_condition.inc
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc

--echo # Let the donor thread report the end of the SST
SET DEBUG_SYNC = 'now SIGNAL continue_wsrep_donor_before_sst_sent';

--echo # The end of the SST is not passed to the new connection
--perl
  my $vardir = $ENV{'MYSQLTEST_VARDIR'};
  open(my $in, '<', "$vardir/tmp/pxc_5327_offset") or die "cannot open: $!";
  my $offset = <$in>;
  close $in;
  my $found = 0;
  for (1..60) {
    open(my $fh, '<', "$vardir/log/mysqld.2.err") or die "cannot open: $!";
    my $n = 0;
    while (my $line = <$fh>) {
      next if ++$n <= $offset;
      $found = 1 if $line =~ /not reporting the end of the SST to the provider/;
    }
    close $fh;
    last if $found;
    sleep 1;
  }
  die "node_2 did not skip reporting the end of the SST\n" unless $found;
EOF
--remove_file $MYSQLTEST_VARDIR/tmp/pxc_5327_offset

--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc

--connection node_1
--let $wait_condition = SELECT VARIABLE_VALUE = 'Synced' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'wsrep_local_state_comment'
--source include/wait_condition.inc

--let $assert_text = node_2 must not report sst_sent() on another connection
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select = sst sent called when not SST donor
--let $assert_count = 0
--source include/assert_grep.inc

--let $assert_text = node_2 sst_sent() must not fail
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_select = wsrep::sst_sent\(\) returned an error
--let $assert_count = 0
--source include/assert_grep.inc

--connection node_2
# The donor thread drops the SST user after sst_sent(), let it finish so that
# the next test starts from the same state
SET SESSION wsrep_on = OFF;
--let $wait_condition = SELECT COUNT(*) = 0 FROM mysql.user WHERE user = 'mysql.pxc.sst.user'
--source include/wait_condition.inc
SET SESSION wsrep_on = ON;
SET DEBUG_SYNC = 'RESET';
