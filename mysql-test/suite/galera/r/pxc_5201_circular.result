SET SESSION sql_log_bin = 0;
CALL mtr.add_suppression("\\[wsrep-acf\\]");
CALL mtr.add_suppression("Pending to replicate MySQL GTID event");
CALL mtr.add_suppression("Storing MySQL user name or password information");
SET SESSION sql_log_bin = 1;
SET SESSION sql_log_bin = 0;
CALL mtr.add_suppression("\\[wsrep-acf\\]");
CALL mtr.add_suppression("Pending to replicate MySQL GTID event");
CALL mtr.add_suppression("Storing MySQL user name or password information");
SET SESSION sql_log_bin = 1;
#
# Setup: configure the inbound channel on each side with auto-positioning,
# but do NOT start it -- the coordinator will (proving the FR-A4 guard is
# satisfied and that START REPLICA is driven by BOTH mode).
#   D2 receives 'a2b' from D1;  D1 receives 'b2a' from D2.
#
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=SERVER_MYPORT_1, SOURCE_USER='root', SOURCE_AUTO_POSITION=1 FOR CHANNEL 'a2b';
CHANGE REPLICATION SOURCE TO SOURCE_HOST='127.0.0.1', SOURCE_PORT=SERVER_MYPORT_2, SOURCE_USER='root', SOURCE_AUTO_POSITION=1 FOR CHANNEL 'b2a';
#
# Enable the coordinator in BOTH mode on both clusters. read_only OFF so
# the test can write on both sides (active-active); default ENFORCE gate.
#
SET GLOBAL wsrep_async_failover_check_interval = 1;
SET GLOBAL wsrep_async_failover_read_only = OFF;
SET GLOBAL wsrep_async_failover_channel = 'b2a';
SET GLOBAL wsrep_async_failover_mode = 'BOTH';
SET GLOBAL wsrep_async_failover = ON;
SET GLOBAL wsrep_async_failover_check_interval = 1;
SET GLOBAL wsrep_async_failover_read_only = OFF;
SET GLOBAL wsrep_async_failover_channel = 'a2b';
SET GLOBAL wsrep_async_failover_mode = 'BOTH';
SET GLOBAL wsrep_async_failover = ON;
#
# The coordinator starts each inbound channel (IO + applier ON).
#
#
# ==== Core: a write on D1 must reach D2 and must NOT loop back to D1. ====
#
CREATE TABLE c1 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO c1 VALUES (1);
# D2 receives c1 with exactly one row.
SELECT COUNT(*) AS c1_rows_on_d2 FROM test.c1;
c1_rows_on_d2
1
#
# ==== Symmetric: a write on D2 must reach D1 and must NOT loop back. ====
#
CREATE TABLE c2 (a INT PRIMARY KEY) ENGINE=InnoDB;
INSERT INTO c2 VALUES (1);
SELECT COUNT(*) AS c2_rows_on_d1 FROM test.c2;
c2_rows_on_d1
1
#
# Give any (erroneous) loop-back a chance to arrive before we assert its
# absence: run one more round trip and settle.
#
INSERT INTO c1 VALUES (2);
INSERT INTO c2 VALUES (2);
#
# ==== Assertions: no loop-back failure on either origin. ====
# The origin's own rows are NOT duplicated (INSERT not re-applied) and the
# inbound applier carries NO error (no 1050 'table exists', no 1062
# 'duplicate entry'), and both threads are still ON.
#
SELECT COUNT(*) AS c1_rows_on_origin_d1 FROM test.c1;
c1_rows_on_origin_d1
2
SELECT SERVICE_STATE AS io_state_b2a
FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME='b2a';
io_state_b2a
ON
SELECT SERVICE_STATE AS applier_state_b2a, LAST_ERROR_NUMBER AS applier_errno_b2a
FROM performance_schema.replication_applier_status_by_coordinator WHERE CHANNEL_NAME='b2a';
applier_state_b2a	applier_errno_b2a
ON	0
SELECT COUNT(*) AS worker_errors_b2a
FROM performance_schema.replication_applier_status_by_worker
WHERE CHANNEL_NAME='b2a' AND LAST_ERROR_NUMBER <> 0;
worker_errors_b2a
0
SELECT GTID_CONSISTENCY AS gtid_verdict_d1
FROM performance_schema.wsrep_async_failover_status;
gtid_verdict_d1
OK
SELECT COUNT(*) AS c2_rows_on_origin_d2 FROM test.c2;
c2_rows_on_origin_d2
2
SELECT SERVICE_STATE AS io_state_a2b
FROM performance_schema.replication_connection_status WHERE CHANNEL_NAME='a2b';
io_state_a2b
ON
SELECT SERVICE_STATE AS applier_state_a2b, LAST_ERROR_NUMBER AS applier_errno_a2b
FROM performance_schema.replication_applier_status_by_coordinator WHERE CHANNEL_NAME='a2b';
applier_state_a2b	applier_errno_a2b
ON	0
SELECT COUNT(*) AS worker_errors_a2b
FROM performance_schema.replication_applier_status_by_worker
WHERE CHANNEL_NAME='a2b' AND LAST_ERROR_NUMBER <> 0;
worker_errors_a2b
0
SELECT GTID_CONSISTENCY AS gtid_verdict_d2
FROM performance_schema.wsrep_async_failover_status;
gtid_verdict_d2
OK
#
# Cleanup. Drop the seed tables while replication is still live so both
# sides converge, THEN tear the coordinator and channels down.
#
DROP TABLE c1;
DROP TABLE c2;
SET GLOBAL wsrep_async_failover = OFF;
SET GLOBAL wsrep_async_failover_mode = 'OFF';
SET GLOBAL wsrep_async_failover_channel = '';
SET GLOBAL wsrep_async_failover_read_only = ON;
SET GLOBAL wsrep_async_failover_check_interval = 5;
STOP REPLICA FOR CHANNEL 'b2a';
RESET REPLICA ALL FOR CHANNEL 'b2a';
SET GLOBAL wsrep_async_failover = OFF;
SET GLOBAL wsrep_async_failover_mode = 'OFF';
SET GLOBAL wsrep_async_failover_channel = '';
SET GLOBAL wsrep_async_failover_read_only = ON;
SET GLOBAL wsrep_async_failover_check_interval = 5;
STOP REPLICA FOR CHANNEL 'a2b';
RESET REPLICA ALL FOR CHANNEL 'a2b';
