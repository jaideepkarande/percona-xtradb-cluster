--source include/galera_cluster_3nodes.inc

--connection node_1
--let $node_1_saved_gipk = `SELECT @@global.sql_generate_invisible_primary_key`
SET GLOBAL sql_generate_invisible_primary_key = ON;
SELECT @@global.sql_generate_invisible_primary_key = 1;

--connection node_2
--let $node_2_saved_gipk = `SELECT @@global.sql_generate_invisible_primary_key`
SET GLOBAL sql_generate_invisible_primary_key = ON;
SELECT @@global.sql_generate_invisible_primary_key = 1;

--connection node_3
--let $node_3_saved_gipk = `SELECT @@global.sql_generate_invisible_primary_key`
SET GLOBAL sql_generate_invisible_primary_key = ON;
SELECT @@global.sql_generate_invisible_primary_key = 1;

--connect node_1b, 127.0.0.1, root, , test, $NODE_MYPORT_1
--connection node_1b
CREATE DATABASE gipk_test_on;
CREATE TABLE gipk_test_on.t1 (id INT NOT NULL, c VARCHAR(100)) ENGINE=InnoDB;
--disconnect node_1b

--connection node_1
--let $pk_count = `SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = 'gipk_test_on' AND table_name = 't1' AND column_name = 'my_row_id'`
--let $assert_text = node_1 should have generated my_row_id
--let $assert_cond = $pk_count = 1
--source include/assert.inc

--connection node_2
--let $pk_count = `SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = 'gipk_test_on' AND table_name = 't1' AND column_name = 'my_row_id'`
--let $assert_text = node_2 should have generated my_row_id
--let $assert_cond = $pk_count = 1
--source include/assert.inc

--connection node_3
--let $pk_count = `SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = 'gipk_test_on' AND table_name = 't1' AND column_name = 'my_row_id'`
--let $assert_text = node_3 should have generated my_row_id
--let $assert_cond = $pk_count = 1
--source include/assert.inc

--connection node_1
DROP DATABASE gipk_test_on;

--connection node_1
--eval SET GLOBAL sql_generate_invisible_primary_key = $node_1_saved_gipk

--connection node_2
--eval SET GLOBAL sql_generate_invisible_primary_key = $node_2_saved_gipk

--connection node_3
--eval SET GLOBAL sql_generate_invisible_primary_key = $node_3_saved_gipk
